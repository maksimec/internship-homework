// Meeting 01 homework starter config.
// Goal: students complete metrics + logs collection pipelines in Alloy.

local.file "endpoints" {
  filename = "/etc/alloy/endpoints.json"
}

livedebugging {
  enabled = false
}

// Remote write destination for Prometheus metrics.
prometheus.remote_write "mimir" {
  endpoint {
    url = json_path(local.file.endpoints.content, ".metrics.url")[0]
  }
}

// Loki write destination for logs.
loki.write "loki" {
  endpoint {
    url = json_path(local.file.endpoints.content, ".logs.url")[0]
  }
}

// ---------------------------------------------------------------------------
// TODO 1: Metrics scraping via Alloy
//
// Add a prometheus.scrape component for nginx-exporter:9113 and forward to:
//   [prometheus.remote_write.mimir.receiver]
//
// Note: if you set scrape_interval below 10s, also set scrape_timeout to a
// smaller value (for example interval 5s, timeout 4s).
//
// Optional: also scrape Alloy itself on localhost:12345.
// ---------------------------------------------------------------------------

prometheus.scrape "nginx_exporter" {
  targets = [
    {"__address__" = "nginx-exporter:9113"},
  ]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.scrape "alloy_self" {
  targets = [
    {"__address__" = "localhost:12345"},
  ]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

// ---------------------------------------------------------------------------
// TODO 2: Logs scraping via Alloy
//
// 1) Add local.file_match with targets for:
//    - /var/log/nginx/access-file.log
//    - /var/log/nginx/error-file.log
//
// 2) Add loki.source.file that tails those files.
//
// 3) Add loki.process to parse access logs and extract labels:
//    - method
//    - uri
//    - status
//
// 4) Forward processed logs to:
//    [loki.write.loki.receiver]
// ---------------------------------------------------------------------------

local.file_match "nginx_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/nginx/access-file.log",
      "job"      = "nginx",
      "log_type" = "access",
    },
    {
      "__path__" = "/var/log/nginx/error-file.log",
      "job"      = "nginx",
      "log_type" = "error",
    },
  ]
}

loki.source.file "nginx_files" {
  targets    = local.file_match.nginx_logs.targets
  forward_to = [loki.process.nginx_parse.receiver]
}

loki.process "nginx_parse" {
  forward_to = [loki.write.loki.receiver]

  // Parse NGINX combined log format:
  // 127.0.0.1 - - [04/Jun/2026:10:00:00 +0000] "GET /path HTTP/1.1" 200 512 "-" "curl/7.88"
  stage.regex {
    expression = `^(?P<remote_addr>\S+) \S+ \S+ \[(?P<time_local>[^\]]+)\] "(?P<method>\S+) (?P<uri>\S+) [^"]+" (?P<status>\d+) (?P<body_bytes_sent>\d+)`
  }

  stage.labels {
    values = {
      method = "method",
      uri    = "uri",
      status = "status",
    }
  }

// ---------------------------------------------------------------------------
// BONUS TODO: Logs -> Metrics in Alloy
//
// Inside loki.process, add a stage.metrics block to create counters from logs,
// for example:
//   - total nginx requests
//   - nginx 5xx requests
//
// Those metrics are exposed on Alloy's /metrics endpoint. If Alloy is scraped
// and remote-written to Mimir, these become Prometheus-compatible metrics that
// can be queried from Grafana using the Mimir datasource.
// ---------------------------------------------------------------------------

  stage.metrics {
    metric.counter {
      name        = "nginx_requests_total"
      description = "Total number of NGINX requests parsed from logs"
      match_all   = true
      action      = "inc"
    }
  }

  stage.match {
    selector = `{status=~"5.."}`

    stage.metrics {
      metric.counter {
        name        = "nginx_5xx_requests_total"
        description = "Total number of NGINX 5xx responses parsed from logs"
        match_all   = true
        action      = "inc"
      }
    }
  }
}
